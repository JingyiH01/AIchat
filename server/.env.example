# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# SiliconFlow 平台 API Key（https://cloud.siliconflow.cn 获取）
SILICONFLOW_API_KEY=sk-xxxxx

# SiliconFlow API 地址
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 服务端口
PORT=3000

# ===== 登录鉴权（D3 用到）=====
# 共享登录密码（固定密码，任何人知道此密码即可登录）
APP_PASSWORD=请设置一个登录密码
# JWT 签名密钥（随便一长串随机字符，生产环境务必保密）
JWT_SECRET=请设置一段足够长的随机字符串

# ===== MySQL 配置（D2 用到）=====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的密码
DB_NAME=ai_chat
