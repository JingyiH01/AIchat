# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# SiliconFlow 平台 API Key（https://cloud.siliconflow.cn 获取）
SILICONFLOW_API_KEY=sk-xxxxx

# SiliconFlow API 地址
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 服务端口
PORT=3000

# ===== MySQL 配置（D2 用到）=====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的密码
DB_NAME=ai_chat
